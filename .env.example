# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./marine_pollution.db
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# AI
AI_CONFIDENCE_THRESHOLD=0.40
# Use mock mode by default. To enable the real detector, provision its weights
# outside Git and set MODEL_PATH to their absolute path.
AI_MODE=mock
MODEL_PATH=/absolute/path/to/plastic_trash_detector.pt

# Uploads
MAX_UPLOAD_SIZE_MB=10
